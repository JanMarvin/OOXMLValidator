# findings that are known and accepted, used by fuzz.R in addition to excel-compat.ignore

# openxlsx2 keeps the attribute names Excel opens (algorithmName, hashPassword, ...)
Sch_UndeclaredAttribute@x:workbook/x:workbookProtection

# openxlsx2 writes hyperlink and image addresses as given, there is no URI check
Opc_MalformedUri
